generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model PriceCategory {
  id    String @id
  label String
  hint  String
  foods Food[] 
}

model Category {
  id          String @id
  label       String
  icon        String
  description String
  foods       Food[]
}

model TimeSlot {
  id    String @id
  label String
  icon  String
  foods Food[]
}

model Food {
  id               Int     @id @default(autoincrement())
  slug             String  @unique
  name             String
  image            String
  shortDescription String
  story            String
  taste            String
  priceRange       String
  featured         Boolean @default(false)
  favoriteCount    Int     @default(0)

  priceCategoryId String
  priceCategory   PriceCategory @relation(fields: [priceCategoryId], references: [id])

  categories  Category[]
  timeSlots   TimeSlot[]
  warungs     Warung[]
  ingredients Ingredient[]
  likes       FoodLike[]
}

model Ingredient {
  id     Int    @id @default(autoincrement())
  name   String
  foodId Int
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)
}

model Warung {
  id          Int    @id @default(autoincrement())
  slug        String @unique
  name        String
  address     String
  openDays    String
  openTime    String
  closeTime   String
  description String
  image       String
  mapsUrl     String

  foods   Food[]
  menus   WarungMenu[]
  ratings Rating[]
}

model WarungMenu {
  id       Int    @id @default(autoincrement())
  name     String
  warungId Int
  warung   Warung @relation(fields: [warungId], references: [id], onDelete: Cascade)
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
}

// akun pengunjung (beda sama Admin)
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  image        String? // foto profil, kosong = pakai inisial nama
  createdAt    DateTime @default(now())

  ratings Rating[]
  likes   FoodLike[]
}

// love dari user ke makanan, total love = jumlah baris per makanan
model FoodLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId    Int
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // 1 user cuma bisa love 1x per makanan
  @@unique([userId, foodId])
}

// rating bintang (1-5) dari user ke warung
model Rating {
  id        Int      @id @default(autoincrement())
  score     Int
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  warungId  Int
  warung    Warung   @relation(fields: [warungId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1 user cuma boleh punya 1 rating per warung (kalau rating lagi = update)
  @@unique([userId, warungId])
}

model Faq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  position Int    @default(0)
}

model SiteContent {
  id                      Int    @id
  heroTitle               String
  heroDescription         String
  heroImage               String @default("/img/hero image.jpeg")
  rekomendasiTitle        String
  rekomendasiDescription  String
  rekomendasiImage        String @default("/img/hero image.jpeg")
  contactEmail            String
  contactPhone            String
  instagram               String
  facebook                String
}
