generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model PriceCategory {
  id    String @id
  label String
  hint  String
  foods Food[] 
}

model Category {
  id          String @id
  label       String
  icon        String
  description String
  foods       Food[]
}

model TimeSlot {
  id    String @id
  label String
  icon  String
  foods Food[]
}

model Food {
  id               Int     @id @default(autoincrement())
  slug             String  @unique
  name             String
  image            String
  shortDescription String
  story            String
  taste            String
  priceRange       String
  featured         Boolean @default(false)

  priceCategoryId String
  priceCategory   PriceCategory @relation(fields: [priceCategoryId], references: [id])

  categories  Category[]
  timeSlots   TimeSlot[]
  warungs     Warung[]
  ingredients Ingredient[]
}

model Ingredient {
  id     Int    @id @default(autoincrement())
  name   String
  foodId Int
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)
}

model Warung {
  id          Int    @id @default(autoincrement())
  slug        String @unique
  name        String
  address     String
  openDays    String
  openTime    String
  closeTime   String
  description String
  image       String
  mapsUrl     String

  foods Food[]
  menus WarungMenu[]
}

model WarungMenu {
  id       Int    @id @default(autoincrement())
  name     String
  warungId Int
  warung   Warung @relation(fields: [warungId], references: [id], onDelete: Cascade)
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
}

model Faq {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
}